FAA_CLIENT_ID=your_client_id_here
FAA_CLIENT_SECRET=your_client_secret_here
PORT=3001

# Auto scrape scheduler (batch + periodic)
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=8
AUTO_SYNC_BATCH_SIZE=5
AUTO_SYNC_INITIAL_DELAY_SECONDS=20

# Optional: comma-separated custom airport list. If empty, all AIRPORTS from src/airportData.ts are used.
# AUTO_SYNC_AIRPORTS=OMAA,OMDB,OBBI

# FAA scrape internal query chunk size. Lower = more reliable, higher = faster.
SCRAPE_CHUNK_SIZE=2

# Data Source Toggles
USE_SCRAPER_DATA=false
USE_AUTOROUTER_API_DATA=true

AUTOROUTER_API_BASE_URL=https://api.autorouter.aero/v1.0
AUTOROUTER_EMAIL=your_email@example.com
AUTOROUTER_PASSWORD=your_password_here

MONGODB_URI=mongodb://localhost:27017/fir-notam
RECORD_TTL_MINUTES=30

RECORD_TTL_MINUTES=30
AUTO_SYNC_PULSE_SECONDS=120